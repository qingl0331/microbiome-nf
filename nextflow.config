/*
 * CBI microbiome pipelines — shared configuration
 *
 * Entry points (run one per invocation):
 *   nextflow run amplicon.nf          -profile chpc ...   # 16S / amplicon (QIIME 2 + DADA2)
 *   nextflow run shotgun.nf           -profile chpc ...   # metagenome / metatranscriptome (MetaPhlAn + HUMAnN)
 *   nextflow run train_classifier.nf  -profile chpc ...   # one-time naive Bayes classifier training
 *
 * Pipeline parameters (with defaults) are declared at the top of each entry script (params.x = ...).
 * Site-specific database locations live in conf/chpc.config.
 */

nextflow.enable.configProcessNamesValidation = false  // shared config serves 3 entry scripts

manifest {
    name            = 'cbi-microbiome'
    description     = 'CBI (Huntsman Cancer Institute) microbiome processing pipelines'
    nextflowVersion = '>=25.10.0'
    version         = '2.0.0'
}

includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'
includeConfig 'conf/modules.config'

profiles {
    chpc {
        includeConfig 'conf/chpc.config'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    docker {
        docker.enabled = true
    }
    // Tiny local run for smoke tests / `-stub` dry runs
    local {
        process.executor       = 'local'
        process.resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
    }
}

// Results are real copies, not symlinks into the work dir (scratch is purged; work dirs get deleted)
workflow.output.mode = 'copy'

// Run-level reports (one set per launch; written next to the launch directory)
timeline {
    enabled = true
    file    = "pipeline_info/timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "pipeline_info/report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "pipeline_info/trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
    fields  = 'task_id,hash,native_id,name,status,exit,submit,start,complete,realtime,duration,%cpu,peak_rss,rss,cpus,memory,attempt,workdir'   // submit/start/complete: queue wait vs run time
}
