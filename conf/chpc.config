/*
 * CHPC (University of Utah) site profile for the CBI core.
 * Edit the lines marked EDIT once; everything else should not need touching per project.
 *
 * Launch from a login node inside screen/tmux (or a small long-running sbatch job):
 *   module load nextflow apptainer          # or a self-installed nextflow >= 25.10
 *   nextflow run <entry>.nf -profile chpc -work-dir /scratch/general/<fs>/$USER/work_<project> ...
 */

params {
    // ---------- EDIT: shared, versioned database root ----------
    db_root = '/uufs/chpc.utah.edu/common/home/hcibcore/u0762203/microbiomeTestPipe/db'

    // Shotgun
    host_index           = '/uufs/chpc.utah.edu/common/home/hcibcore/atlatl/data/FastQ_Screen_Genomes/Human/hg38.no_alt'
    phix_index           = '/uufs/chpc.utah.edu/common/home/hcibcore/atlatl/data/FastQ_Screen_Genomes/PhiX/phi_plus_SNPs'  // same index as fastq_screen.conf
    metaphlan_db         = "${params.db_root}/metaphlan/mpa_vJun23_CHOCOPhlAnSGB_202403"
    humann_nucleotide_db = "${params.db_root}/humann3.9/chocophlan"
    humann_protein_db    = "${params.db_root}/humann3.9/uniref"
    humann_utility_db    = "${params.db_root}/humann3.9/utility_mapping"
    sortmerna_ref        = "${params.db_root}/sortmerna/smr_v4.3_default_db.fasta"
    db_cache             = "${params.db_root}/nf_cache"

    // Shared
    fastq_screen_conf    = "${projectDir}/assets/fastq_screen.conf"
}

process {
    executor       = 'slurm'
    queue          = 'hci-kp'                    // EDIT: partition
    clusterOptions = '--account=hci-kp'          // EDIT: account
    // Largest node you will land on — requests above this are capped instead of failing.
    resourceLimits = [cpus: 20, memory: 120.GB, time: 72.h]   // EDIT to your partition
    cache          = 'lenient'                   // NFS/Lustre timestamps make 'standard' re-run tasks
}

executor {
    queueSize         = 50
    submitRateLimit   = '20/1min'
    pollInterval      = '30 sec'
    queueStatInterval = '2 min'
}

apptainer {
    enabled    = true
    autoMounts = true
    // Database paths referenced *inside* config files (e.g. fastq_screen.conf) are not staged
    // by Nextflow, so bind the shared file systems explicitly.
    runOptions = '-B /uufs/chpc.utah.edu -B /scratch'
    // EDIT: shared image cache so each image is pulled/converted once for the whole core
    cacheDir   = '/uufs/chpc.utah.edu/common/home/hcibcore/u0762203/microbiomeTestPipe/containers/apptainer_cache'
}
