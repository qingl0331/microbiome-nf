/*
 * Default resources. Anything killed for memory/time (exit 104,134,137,139,140,143,247)
 * is retried up to twice with more memory/time. Site maxima are applied through
 * process.resourceLimits in the site profile (conf/chpc.config), so these requests are
 * automatically capped to what a node can actually provide.
 */
process {
    cpus   = 1
    memory = 4.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withLabel: 'process_high_memory' {
        memory = { 128.GB * task.attempt }
    }
    withLabel: 'process_long' {
        time = { 48.h * task.attempt }
    }
}
