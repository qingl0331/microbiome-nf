/*
 * Tool arguments that are not "scientific switches" live here (ext.args), so they can be
 * tuned per project with a small -c custom.config instead of editing pipeline code.
 * Scientific choices (primers, truncation lengths, databases, taxa filters) are params.
 */
process {
    // fastp ~ previous Trimmomatic SLIDINGWINDOW:4:20 MINLEN:50, plus poly-G trimming for
    // two-colour chemistry (NovaSeq/NextSeq) and PE adapter overlap detection.
    withName: 'FASTP' {
        ext.args = '--detect_adapter_for_pe --trim_poly_g --cut_right --cut_right_window_size 4 --cut_right_mean_quality 20 --length_required 50'
    }
    // Remove a pair if EITHER mate aligns to host or PhiX (samtools fastq -f 12 keeps both-unmapped pairs).
    // The same args are used for the host and the PhiX pass.
    withName: 'HOST_REMOVE' {
        ext.args = '--very-sensitive'
    }
    withName: 'METAPHLAN' {
        // e.g. '--unclassified_estimation' or '-t rel_ab_w_read_stats'
        ext.args = ''
    }
    withName: 'HUMANN' {
        // Default prescreen threshold (0.01%) is used. The old pipeline used 0.00001, which pulls
        // in almost every trace species' pangenome and makes the nucleotide step much slower.
        ext.args = '--remove-temp-output'
    }
    withName: 'FASTQ_SCREEN' {
        ext.args = '--subset 200000'
    }
    withName: 'DADA2_DENOISE' {
        // e.g. '--p-pooling-method pseudo' for low-depth / rare-taxa focused projects
        ext.args = ''
    }
}
