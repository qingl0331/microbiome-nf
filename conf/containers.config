/*
 * Pinned containers — one place to bump versions.
 * Tags for the Seqera/biocontainer images were taken from current nf-core/modules pins.
 * With -profile apptainer/singularity, Nextflow pulls these docker images and converts them
 * to .sif files in apptainer.cacheDir (set once in conf/chpc.config) — no hand-built images.
 *
 * Pixi-based Wave images (fastp, multiqc): tools live in /opt/wave/.pixi/envs/default/bin, which only
 * the image ENTRYPOINT (/shell-hook.sh) puts on PATH. `apptainer exec` (what Nextflow uses) skips the
 * entrypoint, so PATH is set via containerOptions. tests/chpc/00_preflight.sh probes with the same PATH.
 */
process {
    // ---------- amplicon ----------
    // QIIME 2 2026.7 ("qiime2" distribution, formerly "amplicon"). Includes cutadapt, python3, biom.
    // NOTE: classifiers must be trained with the same scikit-learn as this image (1.7.x for >=2026.4).
    // NOTE: q2-taxa filter-table include/exclude switch to List[Str] in 2026.10 — re-check FILTER_TAXA
    //       when bumping past 2026.7.
    withName: 'CUTADAPT_PRIMERS|SUGGEST_TRUNC|QIIME_.*|DADA2_.*|MERGE_RUNS|CLASSIFY|FILTER_TAXA|PHYLOGENY|EXPORT_.*|DIVERSITY|TRAIN_.*|IMPORT_REFERENCE' {
        container = 'quay.io/qiime2/qiime2:2026.7'
    }

    // ---------- shotgun ----------
    withName: 'MERGE_LANES|CLUMPIFY' {
        container = 'community.wave.seqera.io/library/bbmap_pigz:07416fe99b090fa9'
    }
    withName: 'FASTP' {
        container = 'community.wave.seqera.io/library/fastp:1.3.6--4df8d6c11b471bde'
        containerOptions = '--env PATH=/opt/wave/.pixi/envs/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'   // pixi image
    }
    withName: 'HOST_REMOVE' {
        container = 'community.wave.seqera.io/library/bowtie2_htslib_samtools_pigz:edeb13799090a2a6'
    }
    withName: 'SORTMERNA.*' {
        container = 'community.wave.seqera.io/library/sortmerna:4.3.7--b730cad73fc42b8e'
    }
    // MetaPhlAn 4.1.1 + mpa_vJun23_CHOCOPhlAnSGB_202403 is the pairing HUMAnN 3.9 expects.
    // Do NOT move to MetaPhlAn 4.2 / vJan25 until HUMAnN officially supports it.
    withName: 'METAPHLAN|MERGE_METAPHLAN' {
        container = 'quay.io/biocontainers/metaphlan:4.1.1--pyhdfd78af_0'
    }
    withName: 'HUMANN|MERGE_HUMANN' {
        container = 'quay.io/biocontainers/humann:3.9--py312hdfd78af_0'
    }

    // ---------- shared ----------
    withName: 'FASTQ_SCREEN' {
        container = 'community.wave.seqera.io/library/fastq-screen_perl-gdgraph:5c1786a5d5bc1309'
    }
    withName: 'MULTIQC|READ_TRACKING' {
        container = 'community.wave.seqera.io/library/multiqc:1.35--c17fb751507e9dfc'
        containerOptions = '--env PATH=/opt/wave/.pixi/envs/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'   // pixi image (also python3 for bin/read_tracking.py)
    }
}
